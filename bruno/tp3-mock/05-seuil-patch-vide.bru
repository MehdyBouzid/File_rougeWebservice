meta {
  name: 05 PATCH seuil vide (mock)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/patients/{{patientId}}/seuils/{{seuilId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test("corps vide refusé avec 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("erreur au format problem+json", function() {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
  });
}
