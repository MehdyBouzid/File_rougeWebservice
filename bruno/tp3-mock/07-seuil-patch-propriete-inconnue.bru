meta {
  name: 07 PATCH seuil propriété inconnue (mock)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/patients/{{patientId}}/seuils/{{seuilId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "actif": true,
    "inconnu": true
  }
}

tests {
  test("propriété inconnue refusée avec 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("erreur au format problem+json", function() {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
  });
}
